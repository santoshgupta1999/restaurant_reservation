<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Booking Reminder</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            /* background: #f3f4f8; */
            font-family: Arial, Helvetica, sans-serif;
            padding: 30px 15px;
            color: #111827;
        }

        table {
            border-spacing: 0;
        }

        .container {
            max-width: 760px;
            margin: auto;
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        /* ================= HEADER ================= */

        .header {
            background: linear-gradient(135deg, #ff2222 0%, #ff2222 45%, #ff2222 100%);
            padding: 17px 28px;
            color: #ffffff;
        }

        .header-table {
            width: 100%;
        }

        .logo-box {
            width: 78px;
            height: 78px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.95);
            text-align: center;
            vertical-align: middle;
            font-size: 38px;
            font-weight: bold;
            color: #ff1c1c;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
        }

        .header-title {
            font-size: 38px;
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: 0.5px;
        }

        .header-subtitle {
            margin-top: 8px;
            font-size: 18px;
            color: rgba(255, 255, 255, 0.92);
        }

        /* ================= CONTENT ================= */

        .content {
            padding: 40px;
        }

        .greeting {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 22px;
            color: #111827;
        }

        .footer {
            background-color: #f3f4f6;
            padding: 18px;
            text-align: center;
            font-size: 13px;
            color: #6b7280;
        }

        .message {
            font-size: 17px;
            line-height: 1.8;
            color: #4b5563;
            margin-bottom: 36px;
        }

        /* ================= DETAILS BOX ================= */

        .details-box {
            border: 1px solid #e4e7ec;
            border-radius: 18px;
            overflow: hidden;
            margin-bottom: 32px;
            background: #ffffff;
        }

        .detail-row {
            width: 100%;
            border-bottom: 1px solid #eceef2;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-table {
            width: 100%;
        }

        .icon-cell {
            width: 74px;
            padding: 20px;
            text-align: center;
            vertical-align: middle;
        }

        .icon-circle {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: #f2efff;
            display: inline-block;
            line-height: 46px;
            font-size: 22px;
            color: #3b1cff;
        }

        .label-cell {
            width: 180px;
            padding: 20px 12px 20px 0;
            vertical-align: middle;
            border-right: 1px solid #eceef2;
        }

        .value-cell {
            padding: 20px 24px;
            vertical-align: middle;
        }

        .label {
            font-size: 16px;
            font-weight: 700;
            color: #111827;
        }

        .value {
            font-size: 16px;
            color: #111827;
            line-height: 1.5;
        }

        /* ================= THANK YOU BOX ================= */

        .thankyou-box {
            background: #f7f5ff;
            border-radius: 18px;
            padding: 22px 24px;
            margin-bottom: 34px;
        }

        .thankyou-table {
            width: 100%;
        }

        .thankyou-icon {
            width: 95px;
            text-align: center;
            font-size: 52px;
            color: #3b1cff;
            vertical-align: middle;
        }

        .thankyou-title {
            font-size: 18px;
            font-weight: 700;
            color: #2b22ff;
            margin-bottom: 10px;
        }

        .thankyou-text {
            font-size: 16px;
            color: #4b5563;
            line-height: 1.6;
        }

        /* ================= HELP BOX ================= */

        .divider {
            border-top: 1px solid #e5e7eb;
            margin-bottom: 28px;
        }

        .help-table {
            width: 100%;
        }

        .help-icon {
            width: 95px;
            text-align: center;
            font-size: 48px;
            color: #3b1cff;
            vertical-align: top;
        }

        .help-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #111827;
        }

        .help-text {
            font-size: 16px;
            line-height: 1.7;
            color: #4b5563;
        }

        /* ================= MOBILE ================= */

        @media only screen and (max-width: 600px) {

            body {
                padding: 10px;
            }

            .content {
                padding: 24px 18px;
            }

            .header {
                padding: 24px 18px;
            }

            .header-title {
                font-size: 26px;
            }

            .header-subtitle {
                font-size: 15px;
            }

            .logo-box {
                width: 58px;
                height: 58px;
                font-size: 28px;
                line-height: 58px;
            }

            .label-cell {
                width: 120px;
            }

            .label,
            .value {
                font-size: 14px;
            }

            .icon-cell {
                width: 58px;
                padding: 16px 10px;
            }

            .value-cell {
                padding: 16px;
            }

            .thankyou-icon,
            .help-icon {
                width: 70px;
                font-size: 36px;
            }
        }
    </style>
</head>

<body>

    <table width="100%" role="presentation">
        <tr>
            <td align="center" style="background: #f3f4f6;">

                <table class="container" width="100%" role="presentation">

                    <!-- HEADER -->
                    <tr>
                        <td class="header">

                            <table class="header-table" role="presentation">
                                <tr>

                                    <td width="90">
                                        <div class="logo-box">
                                            <img src="https://itdevelopmentservices.com/design_website/REMI/assets/images/logo/LoginLogo.png"
                                                style="width:65%; margin-top: 32px;" alt="Logo" />
                                        </div>
                                    </td>

                                    <td>
                                        <div class="header-title">
                                            Booking Reminder
                                        </div>

                                        <div class="header-subtitle">
                                            Your upcoming reservation
                                        </div>
                                    </td>

                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- CONTENT -->
                    <tr>
                        <td class="content">

                            <div class="greeting">
                                Hi <%= fullName %>,
                            </div>

                            <div class="message">
                                Just a quick reminder about your upcoming reservation.
                                <br />
                                We look forward to serving you!
                            </div>

                            <!-- DETAILS -->
                            <div class="details-box">

                                <!-- DATE -->
                                <div class="detail-row">
                                    <table class="detail-table" role="presentation">
                                        <tr>

                                            <td class="icon-cell">
                                                <div class="icon-circle">📅</div>
                                            </td>

                                            <td class="label-cell">
                                                <div class="label">Date</div>
                                            </td>

                                            <td class="value-cell">
                                                <div class="value">
                                                    <%= date %>
                                                </div>
                                            </td>

                                        </tr>
                                    </table>
                                </div>

                                <!-- TIME -->
                                <div class="detail-row">
                                    <table class="detail-table" role="presentation">
                                        <tr>

                                            <td class="icon-cell">
                                                <div class="icon-circle">⏰</div>
                                            </td>

                                            <td class="label-cell">
                                                <div class="label">Time</div>
                                            </td>

                                            <td class="value-cell">
                                                <div class="value">
                                                    <%= time %>
                                                </div>
                                            </td>

                                        </tr>
                                    </table>
                                </div>

                                <!-- GUESTS -->
                                <div class="detail-row">
                                    <table class="detail-table" role="presentation">
                                        <tr>

                                            <td class="icon-cell">
                                                <div class="icon-circle">👥</div>
                                            </td>

                                            <td class="label-cell">
                                                <div class="label">Guests</div>
                                            </td>

                                            <td class="value-cell">
                                                <div class="value">
                                                    <%= partySize %>
                                                </div>
                                            </td>

                                        </tr>
                                    </table>
                                </div>

                                <!-- TABLE DETAILS -->
                                <div class="detail-row">
                                    <table class="detail-table" role="presentation">
                                        <tr>

                                            <td class="icon-cell">
                                                <div class="icon-circle">🪑</div>
                                            </td>

                                            <td class="label-cell">
                                                <div class="label">Table No</div>
                                            </td>

                                            <td class="value-cell">
                                                <div class="value">
                                                    <%= tableNumbers %>
                                                        <% if (floorNames && floorNames !=="-" ) { %>
                                                            (<%= floorNames %>)
                                                                <% } %>
                                                </div>
                                            </td>

                                        </tr>
                                    </table>
                                </div>

                                <!-- RESERVATION -->
                                <div class="detail-row">
                                    <table class="detail-table" role="presentation">
                                        <tr>

                                            <td class="icon-cell">
                                                <div class="icon-circle">🎟</div>
                                            </td>

                                            <td class="label-cell">
                                                <div class="label">Reservation No.</div>
                                            </td>

                                            <td class="value-cell">
                                                <div class="value">
                                                    <%= reservationNo %>
                                                </div>
                                            </td>

                                        </tr>
                                    </table>
                                </div>

                                <!-- RESTAURANT -->
                                <div class="detail-row">
                                    <table class="detail-table" role="presentation">
                                        <tr>

                                            <td class="icon-cell">
                                                <div class="icon-circle">🍽</div>
                                            </td>

                                            <td class="label-cell">
                                                <div class="label">Restaurant Name</div>
                                            </td>

                                            <td class="value-cell">
                                                <div class="value">
                                                    <%= restaurantName %>
                                                </div>
                                            </td>

                                        </tr>
                                    </table>
                                </div>

                                <!-- ADDRESS -->
                                <div class="detail-row">
                                    <table class="detail-table" role="presentation">
                                        <tr>

                                            <td class="icon-cell">
                                                <div class="icon-circle">📍</div>
                                            </td>

                                            <td class="label-cell">
                                                <div class="label">Restaurant Address</div>
                                            </td>

                                            <td class="value-cell">
                                                <div class="value">
                                                    <%= city %>
                                                </div>
                                            </td>

                                        </tr>
                                    </table>
                                </div>

                                <!-- PHONE -->
                                <div class="detail-row">
                                    <table class="detail-table" role="presentation">
                                        <tr>

                                            <td class="icon-cell">
                                                <div class="icon-circle">📞</div>
                                            </td>

                                            <td class="label-cell">
                                                <div class="label">Restaurant Phone</div>
                                            </td>

                                            <td class="value-cell">
                                                <div class="value">
                                                    <%= restaurantPhone %>
                                                </div>
                                            </td>

                                        </tr>
                                    </table>
                                </div>

                            </div>

                            <!-- THANK YOU -->
                            <div class="thankyou-box">

                                <table class="thankyou-table" role="presentation">
                                    <tr>

                                        <td class="thankyou-icon">
                                            🍽
                                        </td>

                                        <td>
                                            <div class="thankyou-title">
                                                Thank you for choosing us.
                                            </div>

                                            <div class="thankyou-text">
                                                We’re excited to welcome you soon.
                                            </div>
                                        </td>

                                    </tr>
                                </table>

                            </div>

                            <!-- DIVIDER -->
                            <div class="divider"></div>

                            <!-- HELP -->
                            <table class="help-table" role="presentation">
                                <tr>

                                    <td class="help-icon">
                                        🎧
                                    </td>

                                    <td>

                                        <div class="help-title">
                                            Need help?
                                        </div>

                                        <div class="help-text">
                                            If you have any questions or need to make changes,
                                            please contact the restaurant.
                                        </div>

                                    </td>

                                </tr>
                            </table>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
        <tr>
            <td class="footer">
                © <%= new Date().getFullYear() %> Remi Restaurant. All rights reserved.
            </td>
        </tr>
    </table>

</body>

</html>