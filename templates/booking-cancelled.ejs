<!DOCTYPE html>
<html>

<body style="margin:0; padding:0; background:#f5f5f5; font-family:Arial;">

    <table width="100%" align="center">
        <tr>
            <td align="center">

                <table width="600" style="background:#fff; padding:20px; margin-top:30px; border-radius:10px;">
                    <tr>
                        <td align="center">
                            <h2 style="color:#dc3545;">❌ Reservation Cancelled</h2>
                        </td>
                    </tr>

                    <tr>
                        <td align="center">
                            <p>Hello,</p>
                            <h3>
                                <%= fullName %>
                            </h3>
                        </td>
                    </tr>

                    <tr>
                        <td align="center">
                            <strong>
                                <%= date %>
                            </strong>
                        </td>
                    </tr>

                    <tr>
                        <td align="center">
                            <span>
                                <%= time %>
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="margin-top:15px; padding:10px; background:#dc3545; color:#fff;">
                            Reservation No: <%= reservationNo %>
                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="padding-top:20px;">
                            <p>Your reservation has been cancelled.</p>
                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="padding-top:20px;">
                            <p>📍 <%= restaurantAddress || "city" %>
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="padding-top:20px; font-size:12px;">
                            This email was sent to <%= email %>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>