<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://itdevelopmentservices.com/design_website/REMI/assets/images/logo/FaveIcon.png" type="image/png"
        rel="icon">
    <link href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
        rel="stylesheet">
    <title>Booking Confirmation</title>

</head>

<body style="margin:0; padding:0; font-family:Rubik, sans-serif;">

    <table style="width:60%; margin:auto; margin-top:30px; margin-bottom:30px; background:#fff">
        <thead>
            <tr>
                <th>
                    <h1
                        style="color: #A3C048; font-weight:500; text-align: center; margin-bottom: 15px; font-size:22px;">
                        <img src="https://itdevelopmentservices.com/design_website/REMI/assets/images/customerBookingFormIcon/customerBookingFormIcon13.png"
                            alt="customerBookingFormIcon" style="margin-right:10px; vertical-align:middle;">
                        <% if (isUpdate) { %>
                            Your reservation has been updated
                            <% } else { %>
                                You’re booked!
                                <% } %>
                    </h1>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><img src="https://sisccltd.com/restaurant_reservation/uploads/restaurants/logo/<%= image %>"
                        alt="BookingConfirmationDetail" style="width:100%;
                    height:201px; object-fit:cover; border-radius: 16px;"></td>
            </tr>

            <tr style="display:block; margin-top:50px; text-align:center; border-radius:15px; padding:5px 20px 10px 20px; 
  box-shadow:0px 0px 3px 0px #ccc;">
                <td style="display:block;">
                    <p style="font-size:18px;">Thank you for your reservation,</p>
                    <h2 style="font-size:20px; margin-top: 30px; margin-bottom:25px;">
                        <%= fullName %>
                    </h2>
                </td>
                <td style="display:block; font-size:18px;"><strong>
                        <%= date %>
                    </strong></td>
                <td style="display:block; margin-top:10px; font-size:16px;"><strong>
                        <%= partySize %> guests
                    </strong><span style="color:#45818A; font-weight:600; font-size:16px;">
                        <%= time %>
                    </span>
                </td>
                <td
                    style="width: 100%; color: #fff; font-size:16px; font-weight:550; margin-top: 20px; padding:15px 0px; border-radius: 15px; background: #9FC6CC; display: inline-block; text-align:center; margin-bottom:10px;">
                    Your reservation number is <%= reservationNo %>
                </td>
            </tr>
            <tr>
                <td style="display: inline-block; width:41%;">
                    <p style="font-size: 16px; font-weight: 550;"><img
                            src="https://itdevelopmentservices.com/design_website/REMI/assets/images/customerBookingFormIcon/customerBookingFormIcon14.png"
                            alt="customerBookingFormIcon" style="margin-right:5px; vertical-align: middle;">add to
                        calendar</p>
                </td>
                <td style="display:inline-block; width:40%;">
                    <p style="font-size: 16px; font-weight: 550;">
                        <a href="https://itdevelopmentservices.com/restaurants/modify-booking/<%= restaurantId %>/<%= reservationId %>"
                            style="text-decoration:none; color:inherit;">

                            <img src="https://itdevelopmentservices.com/design_website/REMI/assets/images/customerBookingFormIcon/customerBookingFormIcon15.png"
                                alt="customerBookingFormIcon" style="margin-right:5px; vertical-align: middle;">
                            modify
                        </a>
                    </p>
                </td>
                <td style="display: inline-block; width:16%;">
                    <p style="font-size: 16px; font-weight: 550;">

                        <a href="https://itdevelopmentservices.com/restaurants/booking-cancel/<%= reservationId %>"
                            style="text-decoration:none; color:inherit;">

                            <img src="https://itdevelopmentservices.com/design_website/REMI/assets/images/customerBookingFormIcon/customerBookingFormIcon16.png"
                                alt="customerBookingFormIcon" style="margin-right:5px; vertical-align: middle;">
                            Cancel

                        </a>

                    </p>
                </td>
            </tr>

            <tr
                style="display:block; text-align:center; border-radius: 15px; padding-bottom:20px; box-shadow: 0px 0px 3px 0px #ccc;">
                <td style="display:block; text-align:center;">
                    <h3 style="font-size:18px;">Contact</h3>
                </td>
                <td style="display:block; text-align:center;">
                    <p style="margin:0px">
                        <%=restaurantName%> - <%=city%>
                    </p>
                </td>
                <td style="display:block; text-align:center;">
                    <p>
                        <%=restaurantPhone%>
                    </p>
                </td>
                <td style="display:inline-block; width:60%;">
                    <a style="display:flex; align-items: center; color: #45818A; text-decoration:none;"
                        href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(restaurantName + ' ' + city) %>"
                        target="_blank">

                        <img src="https://itdevelopmentservices.com/design_website/REMI/assets/images/customerBookingFormIcon/customerBookingFormIcon17.png"
                            alt="map icon" style="margin-right:5px;">

                        view restaurant on map
                    </a>
                </td>
                <td style="display:inline-block; width:30%;">
                    <a style="display:flex; align-items: center; color:#45818A; text-decoration:none;"
                        href="https://itdevelopmentservices.com/design_website/REMI/login.html" target="_blank">
                        <img src="https://itdevelopmentservices.com/design_website/REMI/assets/images/customerBookingFormIcon/customerBookingFormIcon18.png"
                            alt="website Icon" style="margin-right:5px;">open website</a>
                </td>
            </tr>

            <tr
                style="display: block; margin-top:30px; border-radius:15px; padding:20px 20px 20px 20px; box-shadow:0px 0px 3px 0px #ccc;">
                <td style="display: block; text-align: center;">
                    <h3 style="margin:0px; margin-bottom:20px; font-size:16px;">Share Booking with your friends</h3>
                </td>
                <td
                    style="display:inline-block; width:90%; color:#E62727; background:#efe0e0; padding:13px 15px; border-radius:5px; margin-right:10px;">
                    https://itdevelopmentservices.com/restaurants/customer/<%=restaurantId%>
                </td>
                <!-- <td style="display:inline-block;"><img
                        src="https://itdevelopmentservices.com/design_website/REMI/assets/images/customerBookingFormIcon/customerBookingFormIcon19.png"
                        alt="copy Icon"> <img
                        src="https://itdevelopmentservices.com/design_website/REMI/assets/images/customerBookingFormIcon/customerBookingFormIcon20.png"
                        alt="share Icon"></td> -->
            </tr>

            <tr style="display:block; margin-top:30px; padding:15px 15px; border-radius: 20px; background: #E62727;">
                <td style="font-size:13px; color:#fff; line-height:15px; font-weight:500;">
                    <strong
                        style="font-size: 18px; display: block; margin-bottom:25px; text-align: center; margin-top:15px;">
                        Special Requests &amp; Booking Policy
                    </strong>
                    • Minimum Spend: $75 per guest applies for all dinner bookings.<br><br>
                    • Cancellations: Bookings cancelled within 24 hours may incur a $50 per person fee.<br><br>
                    • Special Requests: Note all dietary needs, seating preferences, or celebrations in the reservation
                    system.<br><br>
                    • Communication: Ensure the guest is aware of the above before finalizing the booking.
                </td>
            </tr>

            <tr>
                <td
                    style="display:block; margin:25px 0; text-align:center; border-radius:15px; padding:20px; box-shadow:0px 0px 3px #cccccc;">
                    <h4 style="margin:0 0 10px 0; font-size:20px; font-weight:bold;">A note from us</h4>

                    <h5 style="margin:0 0 10px 0; font-size:16px; font-weight:bold;">Kindly be aware of our policies:
                    </h5>

                    <p style="margin:0 0 15px 0; font-size:14px; line-height:22px; color:#333;">We will do our best to
                        accommodate all requests for preferred<br>
                        tables and areas; however, this cannot be guaranteed and is<br>
                        assessed upon availability.
                    </p>

                    <h6 style="margin:0 0 5px 0; font-size:15px; font-weight:bold;">
                        Dress Code
                    </h6>

                    <p style="margin:0 0 15px 0; font-size:14px; line-height:22px; color:#333;">
                        Restaurant: Smart Casual. Traditional attire Abaya &amp; Gandoura are <br>
                        welcome.
                    </p>

                    <h6 style="margin:0 0 5px 0; font-size:15px; font-weight:bold;">
                        Age Policy
                    </h6>

                    <p style="margin:0 0 15px 0; font-size:14px; line-height:22px; color:#333;">
                        All ages are welcome.
                    </p>

                    <h6 style="margin:0 0 5px 0; font-size:15px; font-weight:bold;">
                        Holding Time
                    </h6>

                    <p style="margin:0; font-size:14px; line-height:22px; color:#333;">
                        Reservations are held for a maximum of 15 minutes. After this grace<br>
                        period, seating is subject to availability. In case you are running late,<br>
                        kindly give us a call; we will try our best to accommodate you upon<br>
                        arrival.
                    </p>
                </td>
            </tr>

            <tr>
                <td>
                    <p>This email was sent to <a href="#" style="color: #E62727; text-decoration: underline;">
                            <%= email%>
                        </a>. If you'd
                        rather not receive this kind of email,</p>
                    <p>you can <a href="#" style="color: #E62727; text-decoration: underline;">unsubscribe</a> or <a
                            href="#" style="color: #E62727; text-decoration: underline;">manage your email
                            preferences</a>.</p>
                </td>
            </tr>

            <tr style="margin-top: 30px; display: block;">
                <td style="width: 70%; display: inline-block;"><img
                        src="https://itdevelopmentservices.com/design_website/REMI/assets/images/logo/LoginLogo.png"
                        style="width:15%;"></td>
                <td style="display: inline-block; width:28%; text-align:right;">
                    <a href="#" style="margin-right: 10px;"><img
                            src="https://itdevelopmentservices.com/design_website/REMI/assets/images/Icon/twitter.png"
                            target="_blank"></a>
                    <a href="#" style="margin-right: 10px;"><img
                            src="https://itdevelopmentservices.com/design_website/REMI/assets/images/Icon/facebook.png"
                            target="_blank"></a>
                    <a href="#"><img
                            src="https://itdevelopmentservices.com/design_website/REMI/assets/images/Icon/instagram.png"
                            target="_blank"></a>
                </td>
            </tr>

        </tbody>
    </table>

</body>

</html>